APP_NAME="AACS Backend"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration (MySQL / MariaDB on Raspberry Pi)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aacs_db
DB_USERNAME=aacs
DB_PASSWORD=your_database_password_here

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

# MQTT Broker Configuration (Mosquitto on Raspberry Pi)
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_CLIENT_ID=aacs_backend_worker
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=false

# Firebase Cloud Messaging (FCM) Push Notifications
FIREBASE_CREDENTIALS=storage/app/firebase/aacs-firebase-adminsdk.json
FIREBASE_PROJECT_ID=aacs-fc1a6
